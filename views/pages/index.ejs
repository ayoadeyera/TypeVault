<%- include('../partials/header') %>
<%- include('../partials/nav') %>

    <!-- Main Content Area: Typing Arena -->
    <main>
      <!-- Mode Controls Bar -->
      <section class="controls-panel" aria-label="Drill Mode Selector">
        <div class="mode-selector-bar">
          <div class="mode-pills-group">
            <button class="mode-btn active" data-mode="speed" id="mode-btn-speed">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
              Speed & Flow
            </button>
            <button class="mode-btn" data-mode="accuracy" id="mode-btn-accuracy">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
              Accuracy & Symbols
            </button>
            <button class="mode-btn" data-mode="code" id="mode-btn-code">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
              Code & CS Syntax
            </button>
            <button class="mode-btn" data-mode="custom" id="mode-btn-custom">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
              Custom Sandbox
            </button>
          </div>
        </div>

        <!-- Sub-controls Bar (Pool size, code languages, duration toggles) -->
        <div class="sub-controls-bar" id="sub-controls-bar">
          <div class="sub-pills-group" id="sub-pills-container">
            <!-- Dynamically populated by app.js -->
          </div>
          <div class="sub-pills-group" id="duration-pills-container">
            <!-- Dynamically populated by app.js -->
          </div>
        </div>
      </section>

      <!-- Real-Time Analytics HUD -->
      <section class="analytics-hud" aria-label="Live Typing Metrics">
        <div class="stat-card" id="card-wpm">
          <div class="stat-label">Live WPM <span>⚡</span></div>
          <div class="stat-value accent" id="hud-wpm">0</div>
          <div class="stat-sub">Words / Min</div>
        </div>

        <div class="stat-card" id="card-cpm">
          <div class="stat-label">Raw CPM <span>⌨</span></div>
          <div class="stat-value" id="hud-cpm">0</div>
          <div class="stat-sub">Chars / Min</div>
        </div>

        <div class="stat-card" id="card-acc">
          <div class="stat-label">Accuracy <span>🎯</span></div>
          <div class="stat-value correct" id="hud-acc">100%</div>
          <div class="stat-sub">Precision Rate</div>
        </div>

        <div class="stat-card" id="card-errors">
          <div class="stat-label">Errors <span>⚠️</span></div>
          <div class="stat-value incorrect" id="hud-errors">0</div>
          <div class="stat-sub">Typo Count</div>
        </div>

        <div class="stat-card" id="card-timer">
          <div class="stat-label">Timer <span>⏱</span></div>
          <div class="stat-value" id="hud-timer">30s</div>
          <div class="stat-sub">Remaining / Elapsed</div>
        </div>
      </section>

      <!-- Target/Session Progress Bar -->
      <div class="session-progress-bar" title="Session Completion Progress">
        <div class="session-progress-fill" id="session-progress-fill"></div>
      </div>

      <!-- Live Daily Duration Goal Bar -->
      <div class="goal-live-hud" id="goal-live-hud" title="Daily Practice Goal Progress (Active Drill)">
        <div class="goal-live-info">
          <div class="goal-live-title">
            <span class="goal-live-icon">🎯</span>
            <span class="goal-live-label">Daily Goal:</span>
            <strong id="live-goal-time">0.0 / 15 mins</strong>
          </div>
          <div class="goal-live-percent">
            <span id="live-goal-pct">0%</span>
          </div>
        </div>
        <div class="goal-live-track">
          <div class="goal-live-fill" id="live-goal-fill" style="width: 0%"></div>
        </div>
      </div>

      <!-- Typing Arena -->
      <section class="typing-arena-wrapper">
        <div class="typing-arena" id="typing-arena" tabindex="0" role="textbox" aria-label="Typing Drill Arena">
          <input type="text" class="hidden-input" id="hidden-input" autocomplete="off" autocapitalize="off" spellcheck="false">
          
          <div class="arena-focus-overlay" id="arena-focus-overlay">
            <div class="focus-hint-badge">
              <span>⌨️</span> Click or press any key to focus & begin
            </div>
          </div>

          <div class="caret caret-line" id="caret"></div>
          <div class="words-container" id="words-container">
            <!-- Character spans populated by engine.js -->
          </div>
        </div>

        <!-- Quick Hotkeys & Restart Bar -->
        <div class="arena-footer-controls">
          <div class="quick-keys-hints">
            <span class="key-badge"><kbd>Tab</kbd> + <kbd>Enter</kbd> Restart Drill</span>
            <span class="key-badge"><kbd>Ctrl</kbd> + <kbd>⌫</kbd> Word Delete</span>
            <span class="key-badge"><kbd>Esc</kbd> Reset / Close</span>
          </div>

          <button id="btn-restart" class="btn-restart-action" title="Restart current drill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
            </svg>
            Restart
          </button>
        </div>
      </section>
    </main>

    <!-- Results Modal -->
    <div class="modal-backdrop" id="results-modal" role="dialog" aria-modal="true" aria-labelledby="results-title">
      <div class="modal-content">
        <div class="modal-header">
          <div class="modal-title" id="results-title">
            <span>🏆</span> Drill Performance Summary
          </div>
          <button class="modal-close-btn" id="modal-close-btn" aria-label="Close modal">✕</button>
        </div>

        <!-- Cloud sync badge — revealed after successful DB/session sync -->
        <div id="cloud-sync-badge" class="cloud-synced-badge" hidden>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          ☁ Cloud Synced
        </div>

        <!-- Hero Headline Stats -->
        <div class="results-hero-grid">
          <div class="result-hero-card primary">
            <div class="hero-label">Net Speed</div>
            <div class="hero-value" id="res-wpm">0</div>
            <div class="hero-sub">Words Per Minute</div>
          </div>

          <div class="result-hero-card correct">
            <div class="hero-label">Accuracy</div>
            <div class="hero-value" id="res-acc">100%</div>
            <div class="hero-sub">Keystroke Precision</div>
          </div>

          <div class="result-hero-card">
            <div class="hero-label">Raw Speed</div>
            <div class="hero-value" id="res-raw-wpm">0</div>
            <div class="hero-sub">Raw WPM</div>
          </div>
        </div>

        <!-- SVG Consistency & Pace Chart -->
        <div class="chart-card">
          <div class="chart-header">
            <span>Speed & Pace Progression</span>
            <span>Consistency: <strong id="res-consistency" style="color: var(--color-accent)">100%</strong></span>
          </div>
          <div class="chart-svg-container" id="results-chart-container">
            <!-- SVG rendered by analytics.js -->
          </div>
        </div>

        <!-- Error & Keystroke Breakdown -->
        <div class="breakdown-grid">
          <div class="breakdown-item">
            <div class="b-label">Session Duration</div>
            <div class="b-value" id="res-time">0s</div>
          </div>
          <div class="breakdown-item">
            <div class="b-label">Correct Keystrokes</div>
            <div class="b-value" style="color: var(--color-correct)" id="res-correct-chars">0</div>
          </div>
          <div class="breakdown-item">
            <div class="b-label">Error Keystrokes</div>
            <div class="b-value" style="color: var(--color-incorrect)" id="res-error-chars">0</div>
          </div>
          <div class="breakdown-item">
            <div class="b-label">Extra Typed</div>
            <div class="b-value" style="color: var(--color-extra)" id="res-extra-chars">0</div>
          </div>
          <div class="breakdown-item">
            <div class="b-label">Missed Chars</div>
            <div class="b-value" style="color: var(--text-muted)" id="res-missed-chars">0</div>
          </div>
        </div>

        <!-- Actions -->
        <div class="modal-actions">
          <button class="btn-secondary" id="btn-modal-close">Dismiss</button>
          <button class="btn-primary" id="btn-modal-restart">
            <span>⚡</span> Next Drill <kbd style="font-size: 0.75rem; background: rgba(255,255,255,0.2); padding: 0.15rem 0.4rem; border-radius: 4px; margin-left: 0.25rem;">Tab+Enter</kbd>
          </button>
        </div>
      </div>
    </div>

    <!-- Settings Sliding Drawer -->
    <div class="drawer-backdrop" id="drawer-backdrop"></div>
    <aside class="settings-drawer" id="settings-drawer" aria-label="Settings and Preferences">
      <div class="drawer-header">
        <div class="drawer-title">
          <span>⚙️</span> Customization & Preferences
        </div>
        <button class="btn-icon" id="drawer-close-btn" aria-label="Close Settings">✕</button>
      </div>

      <div class="drawer-body">
        <!-- Visual Theme Picker -->
        <div class="settings-group">
          <div class="settings-group-title">Visual Theme</div>
          <div class="theme-options-grid" id="theme-options-grid">
            <!-- Populated by app.js -->
          </div>
        </div>

        <!-- Typography & Fonts -->
        <div class="settings-group">
          <div class="settings-group-title">Typography & Caret</div>
          <div class="settings-control-row">
            <label class="settings-label" for="font-select">Monospace Font</label>
            <select class="settings-select" id="font-select">
              <!-- Populated by app.js -->
            </select>
          </div>

          <div class="settings-control-row">
            <label class="settings-label" for="caret-select">Caret Style</label>
            <select class="settings-select" id="caret-select">
              <!-- Populated by app.js -->
            </select>
          </div>
        </div>

        <!-- Mechanical Keyboard Audio Synthesizer -->
        <div class="settings-group">
          <div class="settings-group-title">Mechanical Switch Sound (Web Audio)</div>
          <div class="settings-control-row">
            <label class="settings-label" for="sound-toggle">Enable Switch Audio</label>
            <label class="settings-toggle">
              <input type="checkbox" id="sound-toggle" checked>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <div class="settings-control-row">
            <label class="settings-label" for="sound-type-select">Switch Type</label>
            <select class="settings-select" id="sound-type-select">
              <option value="blue">Clicky Blue (Crisp Snap)</option>
              <option value="brown">Tactile Brown (Gentle Bump)</option>
              <option value="linear">Thocky Linear (Deep Low Thock)</option>
              <option value="beep">Subtle Sine Beep</option>
            </select>
          </div>

          <div class="settings-control-row">
            <label class="settings-label" for="volume-slider">Volume</label>
            <input type="range" id="volume-slider" min="0" max="100" value="40" style="accent-color: var(--color-accent); cursor: pointer;">
          </div>
        </div>

        <!-- Target Pacer -->
        <div class="settings-group">
          <div class="settings-group-title">Target WPM Goal</div>
          <div class="settings-control-row">
            <label class="settings-label" for="target-wpm-input">Target Speed</label>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <input type="range" id="target-wpm-input" min="30" max="160" step="5" value="80" style="accent-color: var(--color-accent); cursor: pointer;">
              <span class="stat-sub" id="target-wpm-value" style="font-weight: 700; min-width: 60px;">80 WPM</span>
            </div>
          </div>
        </div>
      </div>
    </aside>

    <!-- Custom Snippet Manager Modal -->
    <div class="modal-backdrop custom-manager-modal" id="custom-modal" role="dialog" aria-modal="true" aria-labelledby="custom-modal-title">
      <div class="modal-content">
        <div class="modal-header">
          <div class="modal-title" id="custom-modal-title">
            <span>🧪</span> Custom Sandbox & Snippet Manager
          </div>
          <button class="modal-close-btn" id="custom-modal-close-btn" aria-label="Close modal">✕</button>
        </div>

        <div>
          <label class="settings-label" for="custom-snippet-title">Snippet Title / Label</label>
          <input type="text" id="custom-snippet-title" placeholder="e.g. My React Hook Drill, SQL Query #4" style="width: 100%; padding: 0.6rem 0.9rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); margin-top: 0.4rem; color: var(--text-primary); outline: none;">

          <label class="settings-label" for="custom-snippet-text" style="display: block; margin-top: 1rem;">Drill Text or Code Block</label>
          <textarea id="custom-snippet-text" class="custom-textarea" placeholder="Paste your custom text, lyrics, markdown, or multi-line source code here..."></textarea>

          <div style="display: flex; gap: 0.75rem; justify-content: flex-end;">
            <button class="btn-secondary" id="btn-save-custom">💾 Save Snippet</button>
            <button class="btn-primary" id="btn-start-custom-drill">⚡ Start Drill Now</button>
          </div>
        </div>

        <div style="margin-top: 1.75rem;">
          <div class="settings-group-title">Saved Snippet Buckets</div>
          <div class="saved-snippets-list" id="saved-snippets-list">
            <!-- Populated by app.js -->
          </div>
        </div>
      </div>
    </div>

    <!-- Authentication Modal -->
    <div class="modal-backdrop" id="auth-modal" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title">
      <div class="modal-content auth-modal-content">
        <div class="modal-header">
          <div class="modal-title" id="auth-modal-title">
            <span>⚡</span> Type Station Account
          </div>
          <button class="modal-close-btn" id="auth-modal-close" aria-label="Close">✕</button>
        </div>

        <!-- Tab Switcher -->
        <div class="auth-tabs" role="tablist">
          <button class="auth-tab active" id="auth-tab-signin" role="tab" aria-selected="true">Sign In</button>
          <button class="auth-tab" id="auth-tab-register" role="tab" aria-selected="false">Create Account</button>
        </div>

        <!-- Sign In Form -->
        <div class="auth-form" id="auth-form-signin">
          <div class="auth-field-group">
            <label class="settings-label" for="signin-email">Email</label>
            <input type="email" id="signin-email" class="auth-input" placeholder="you@example.com" autocomplete="email">
          </div>
          <div class="auth-field-group">
            <label class="settings-label" for="signin-password">Password</label>
            <input type="password" id="signin-password" class="auth-input" placeholder="••••••••" autocomplete="current-password">
          </div>
          <p class="auth-error" id="signin-error"></p>
          <button class="btn-primary auth-submit-btn" id="btn-do-signin">Sign In →</button>
        </div>

        <!-- Register Form -->
        <div class="auth-form" id="auth-form-register" style="display:none">
          <div class="auth-field-group">
            <label class="settings-label" for="reg-username">Username</label>
            <input type="text" id="reg-username" class="auth-input" placeholder="developer_pro" autocomplete="username">
          </div>
          <div class="auth-field-group">
            <label class="settings-label" for="reg-email">Email</label>
            <input type="email" id="reg-email" class="auth-input" placeholder="you@example.com" autocomplete="email">
          </div>
          <div class="auth-field-group">
            <label class="settings-label" for="reg-password">Password</label>
            <input type="password" id="reg-password" class="auth-input" placeholder="•••••••• (min 6 chars)" autocomplete="new-password">
          </div>
          <p class="auth-error" id="reg-error"></p>
          <button class="btn-primary auth-submit-btn" id="btn-do-register">Create Account →</button>
        </div>
      </div>
    </div>

    <!-- Goals & Diagnostic Insights Modal -->
    <div class="modal-backdrop" id="goals-modal" role="dialog" aria-modal="true" aria-labelledby="goals-modal-title">
      <div class="modal-content goals-modal-content">
        <div class="modal-header">
          <div class="modal-title" id="goals-modal-title">
            <span>🎯</span> Goals & Diagnostic Insights
          </div>
          <button class="modal-close-btn" id="goals-modal-close" aria-label="Close Goals Modal">✕</button>
        </div>

        <div class="goals-modal-body">
          <!-- Section 1: Practice Duration Goals -->
          <div class="goals-section">
            <div class="goals-section-header">
              <h3 class="goals-section-title">Practice Duration Milestones</h3>
              <span class="goals-section-sub">Cumulative active typing windows across daily, weekly, and monthly targets</span>
            </div>

            <div class="goals-progress-grid">
              <!-- Daily Card -->
              <div class="goal-window-card">
                <div class="goal-window-top">
                  <span class="goal-window-badge">Daily Window</span>
                  <span class="goal-window-pct" id="modal-daily-pct">0%</span>
                </div>
                <div class="goal-window-metric">
                  <span class="goal-metric-value" id="modal-daily-curr">0.0</span>
                  <span class="goal-metric-sep">/</span>
                  <span class="goal-metric-target" id="modal-daily-target">15 mins</span>
                </div>
                <div class="goal-window-bar">
                  <div class="goal-window-fill" id="modal-daily-fill" style="width: 0%"></div>
                </div>
              </div>

              <!-- Weekly Card -->
              <div class="goal-window-card">
                <div class="goal-window-top">
                  <span class="goal-window-badge">Weekly Window</span>
                  <span class="goal-window-pct" id="modal-weekly-pct">0%</span>
                </div>
                <div class="goal-window-metric">
                  <span class="goal-metric-value" id="modal-weekly-curr">0.0</span>
                  <span class="goal-metric-sep">/</span>
                  <span class="goal-metric-target" id="modal-weekly-target">75 mins</span>
                </div>
                <div class="goal-window-bar">
                  <div class="goal-window-fill" id="modal-weekly-fill" style="width: 0%"></div>
                </div>
              </div>

              <!-- Monthly Card -->
              <div class="goal-window-card">
                <div class="goal-window-top">
                  <span class="goal-window-badge">Monthly Window</span>
                  <span class="goal-window-pct" id="modal-monthly-pct">0%</span>
                </div>
                <div class="goal-window-metric">
                  <span class="goal-metric-value" id="modal-monthly-curr">0.0</span>
                  <span class="goal-metric-sep">/</span>
                  <span class="goal-metric-target" id="modal-monthly-target">300 mins</span>
                </div>
                <div class="goal-window-bar">
                  <div class="goal-window-fill" id="modal-monthly-fill" style="width: 0%"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section 2: Weak Keys & AI Coaching Insights -->
          <div class="goals-section">
            <div class="goals-section-header">
              <h3 class="goals-section-title">Diagnostic Weak-Spots & Coaching</h3>
              <span class="goals-section-sub">Automated error frequency analysis and algorithmic reach recommendations</span>
            </div>

            <!-- Weakest Keys Chips -->
            <div class="weak-keys-container">
              <div class="weak-keys-title">
                <span>⚠️</span> Top Weakest Keys:
              </div>
              <div class="weak-keys-list" id="weak-keys-list">
                <!-- Populated dynamically -->
              </div>
            </div>

            <!-- Smart AI Recommendation Cards -->
            <div class="ai-recommendations-list" id="ai-recommendations-list">
              <!-- Populated dynamically -->
            </div>
          </div>

          <!-- Section 3: Goal Benchmarks Configuration -->
          <div class="goals-section">
            <div class="goals-section-header">
              <h3 class="goals-section-title">Goal Targets & Benchmarks</h3>
              <span class="goals-section-sub">Adjust your target duration windows, mode WPM benchmarks, and target precision</span>
            </div>

            <form id="goals-config-form" class="goals-config-grid">
              <div class="goals-input-group">
                <label for="input-goal-daily">Daily Goal (mins)</label>
                <input type="number" id="input-goal-daily" min="1" max="300" class="goals-input" required>
              </div>

              <div class="goals-input-group">
                <label for="input-goal-weekly">Weekly Goal (mins)</label>
                <input type="number" id="input-goal-weekly" min="5" max="2000" class="goals-input" required>
              </div>

              <div class="goals-input-group">
                <label for="input-goal-monthly">Monthly Goal (mins)</label>
                <input type="number" id="input-goal-monthly" min="20" max="10000" class="goals-input" required>
              </div>

              <div class="goals-input-group">
                <label for="input-target-speed">Target WPM (Speed Mode)</label>
                <input type="number" id="input-target-speed" min="20" max="250" class="goals-input" required>
              </div>

              <div class="goals-input-group">
                <label for="input-target-accuracy">Target WPM (Symbols Mode)</label>
                <input type="number" id="input-target-accuracy" min="15" max="200" class="goals-input" required>
              </div>

              <div class="goals-input-group">
                <label for="input-target-code">Target WPM (Code Mode)</label>
                <input type="number" id="input-target-code" min="10" max="180" class="goals-input" required>
              </div>

              <div class="goals-input-group">
                <label for="input-target-acc-pct">Target Accuracy (%)</label>
                <input type="number" id="input-target-acc-pct" min="80" max="100" class="goals-input" required>
              </div>

              <div class="goals-form-actions">
                <button type="submit" class="btn-primary goals-save-btn" id="btn-save-goals">
                  <span>💾</span> Save Benchmarks
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Toast Notifications Container -->
    <div class="toast-container" id="toast-container" aria-live="polite"></div>

<%- include('../partials/footer') %>
